-----------------------------------------------------#ifndef PERCEPTRON_NAND_H
#define PERCEPTRON_NAND_H

#include <ap_int.h>
#include <ap_fixed.h>

// ---------------------------------------------------------------------------
// Number format
// ap_fixed<20,4>: 4 integer bits (incl. sign) -> range [-8, 8)
//                16 fractional bits          -> resolution ~1.5e-5
// AP_RND rounds constants like 0.1 to the nearest step, AP_SAT clips instead
// of wrapping around if a value ever goes out of range.
// ---------------------------------------------------------------------------
typedef ap_fixed<20, 4, AP_RND, AP_SAT> data_t;

#define N_INPUTS   2
#define N_SAMPLES  4      // 4 rows of the 2-input NAND truth table
#define N_EPOCHS   20     // as suggested in the hint

// Learning rate (eta)
const data_t ETA = 0.1;

// Arbitrary initial weights and bias (change these and re-run to experiment)
const data_t W1_INIT   =  0.5;
const data_t W2_INIT   = -0.3;
const data_t BIAS_INIT = -0.2;

// ---------------------------------------------------------------------------
// Board I/O mapping (16 switches in, 16 LEDs out)
//
//   sw[0]      : input a        (to test the trained NAND)
//   sw[1]      : input b
//   sw[15:14]  : display select  00 -> w1, 01 -> w2, 10 -> bias, 11 -> epochs
//
//   leds[7:0]  : |selected value| x 10, in binary (0.3 -> 00000011)
//                (for select = 11: epoch at which training converged)
//   leds[8]    : 1 if the selected value is negative
//   leds[9]    : 1 if w1   is negative
//   leds[10]   : 1 if w2   is negative
//   leds[11]   : 1 if bias is negative
//   leds[13:12]: unused (0)
//   leds[14]   : 1 if training converged within N_EPOCHS
//   leds[15]   : perceptron output y = NAND(a, b)
// ---------------------------------------------------------------------------
#define SEL_W1     0
#define SEL_W2     1
#define SEL_BIAS   2
#define SEL_EPOCH  3

#define LED_NEG_SEL   8
#define LED_NEG_W1    9
#define LED_NEG_W2    10
#define LED_NEG_BIAS  11
#define LED_DONE      14
#define LED_Y         15

// Trains the perceptron on the NAND truth table.
// conv_epoch = first epoch with zero errors (0 if it never converged).
// verbose = true prints the per-epoch trace during C simulation only.
void train_nand(data_t &w1, data_t &w2, data_t &bias,
                ap_uint<5> &conv_epoch, bool verbose);

// Top-level function (this is what gets synthesised to RTL)
void perceptron_nand(ap_uint<16> sw, ap_uint<16> &leds);

#endif

