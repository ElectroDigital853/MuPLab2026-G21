#include "perceptron_nand.h"
#ifndef __SYNTHESIS__
#include <cstdio>
#endif

// Step activation from Figure 1: c = 1 if z >= 0, else 0
static ap_uint<1> step(data_t z)
{
    return (z >= 0) ? 1 : 0;
}

// |v| * 10, rounded to nearest integer, for display on 8 LEDs
static ap_uint<8> to_tenths(data_t v)
{
    data_t mag = (v < 0) ? (data_t)(-v) : v;
    ap_ufixed<16, 8> scaled = mag * 10;
    scaled += ap_ufixed<16, 8>(0.5);
    return scaled.to_uint();
}

void train_nand(data_t &w1, data_t &w2, data_t &bias,
                ap_uint<5> &conv_epoch, bool verbose)
{
    // NAND training data
    const ap_uint<1> X1[N_SAMPLES] = {0, 0, 1, 1};
    const ap_uint<1> X2[N_SAMPLES] = {0, 1, 0, 1};
    const ap_uint<1> T [N_SAMPLES] = {1, 1, 1, 0};

    w1   = W1_INIT;
    w2   = W2_INIT;
    bias = BIAS_INIT;
    conv_epoch = 0;

EPOCH_LOOP:
    for (int e = 0; e < N_EPOCHS; e++) {
        ap_uint<3> errors = 0;

    SAMPLE_LOOP:
        for (int i = 0; i < N_SAMPLES; i++) {
            // forward pass
            data_t     z = w1 * X1[i] + w2 * X2[i] + bias;
            ap_uint<1> y = step(z);

            // perceptron learning rule: w <- w + eta * (t - y) * x
            ap_int<2> err   = (ap_int<2>)T[i] - (ap_int<2>)y;   // -1, 0 or +1
            data_t    delta = ETA * err;

            w1   += delta * X1[i];
            w2   += delta * X2[i];
            bias += delta;

            if (err != 0) errors++;
        }

#ifndef __SYNTHESIS__
        if (verbose)
            printf("Epoch %2d | errors = %d | w1 = %7.3f  w2 = %7.3f  bias = %7.3f\n",
                   e + 1, (int)errors, w1.to_double(), w2.to_double(), bias.to_double());
#endif

        // remember the first epoch that had no mistakes
        if (errors == 0 && conv_epoch == 0)
            conv_epoch = e + 1;
    }
}

void perceptron_nand(ap_uint<16> sw, ap_uint<16> &leds)
{
#pragma HLS INTERFACE mode=ap_ctrl_hs port=return
#pragma HLS INTERFACE mode=ap_none    port=sw
#pragma HLS INTERFACE mode=ap_vld     port=leds

    // 1. Train on the FPGA
    data_t     w1, w2, bias;
    ap_uint<5> conv_epoch;
    train_nand(w1, w2, bias, conv_epoch, false);

    // 2. Read the switches
    ap_uint<1> a   = sw[0];
    ap_uint<1> b   = sw[1];
    ap_uint<2> sel = sw.range(15, 14);

    // 3. Run the trained perceptron on (a, b)
    ap_uint<1> y = step(w1 * a + w2 * b + bias);

    // 4. Pick what to show on the magnitude LEDs
    data_t     shown;
    ap_uint<8> mag;
    ap_uint<1> neg;
    if (sel == SEL_EPOCH) {
        mag = conv_epoch;
        neg = 0;
    } else {
        shown = (sel == SEL_W1) ? w1 : (sel == SEL_W2) ? w2 : bias;
        mag   = to_tenths(shown);
        neg   = (shown < 0) ? 1 : 0;
    }

    // 5. Pack everything onto the LEDs
    ap_uint<16> out = 0;
    out.range(7, 0)     = mag;
    out[LED_NEG_SEL]    = neg;
    out[LED_NEG_W1]     = (w1   < 0) ? 1 : 0;
    out[LED_NEG_W2]     = (w2   < 0) ? 1 : 0;
    out[LED_NEG_BIAS]   = (bias < 0) ? 1 : 0;
    out[LED_DONE]       = (conv_epoch != 0) ? 1 : 0;
    out[LED_Y]          = y;

    leds = out;
}
