#include <cstdio>
#include "perceptron_nand.h"

// Turns the LED pattern back into a signed value, i.e. what you'd read off the board
static double decode(ap_uint<16> leds)
{
    double v = (int)leds.range(7, 0) / 10.0;
    return leds[LED_NEG_SEL] ? -v : v;
}

static ap_uint<16> make_sw(int a, int b, int sel)
{
    ap_uint<16> sw = 0;
    sw[0] = a;
    sw[1] = b;
    sw.range(15, 14) = sel;
    return sw;
}

int main()
{
    int fails = 0;

    printf("=====================================================\n");
    printf(" Perceptron training for 2-input NAND   (eta = %.1f)\n", ETA.to_double());
    printf(" Initial: w1 = %.3f  w2 = %.3f  bias = %.3f\n",
           W1_INIT.to_double(), W2_INIT.to_double(), BIAS_INIT.to_double());
    printf("=====================================================\n");

    // ---- 1. training trace + final parameters --------------------------------
    data_t     w1, w2, bias;
    ap_uint<5> conv_epoch;
    train_nand(w1, w2, bias, conv_epoch, true);

    printf("-----------------------------------------------------\n");
    printf(" Final weights : w1 = %.3f   w2 = %.3f\n", w1.to_double(), w2.to_double());
    printf(" Final bias    : b  = %.3f\n", bias.to_double());
    if (conv_epoch != 0)
        printf(" Converged at epoch %d\n", (int)conv_epoch);
    else {
        printf(" Did NOT converge in %d epochs\n", N_EPOCHS);
        fails++;
    }

    // ---- 2. verify the synthesised top function on all NAND inputs -----------
    printf("-----------------------------------------------------\n");
    printf(" Verification (through top function perceptron_nand)\n");
    printf("  a  b | expected | got | result\n");
    for (int a = 0; a <= 1; a++) {
        for (int b = 0; b <= 1; b++) {
            ap_uint<16> leds;
            perceptron_nand(make_sw(a, b, SEL_W1), leds);
            int expected = !(a && b);
            int got      = leds[LED_Y];
            int ok       = (expected == got);
            if (!ok) fails++;
            printf("  %d  %d |    %d     |  %d  | %s\n", a, b, expected, got, ok ? "PASS" : "FAIL");
        }
    }

    // ---- 3. what the LEDs will show for each display-select setting ---------
    printf("-----------------------------------------------------\n");
    printf(" LED output (sw[15:14] = display select)\n");
    const char *names[4] = {"w1", "w2", "bias", "epoch"};
    for (int sel = 0; sel < 4; sel++) {
        ap_uint<16> leds;
        perceptron_nand(make_sw(0, 0, sel), leds);
        printf("  sel=%d (%-5s) leds = %s  -> ", sel, names[sel],
               leds.to_string(2, false).c_str());
        if (sel == SEL_EPOCH)
            printf("%d\n", (int)leds.range(7, 0));
        else
            printf("%+.1f\n", decode(leds));
    }

    ap_uint<16> leds;
    perceptron_nand(make_sw(0, 0, SEL_W1), leds);
    printf("  sign LEDs: w1 %s, w2 %s, bias %s\n",
           leds[LED_NEG_W1]   ? "NEG" : "pos",
           leds[LED_NEG_W2]   ? "NEG" : "pos",
           leds[LED_NEG_BIAS] ? "NEG" : "pos");

    printf("=====================================================\n");
    if (fails == 0) printf(" ALL TESTS PASSED\n");
    else            printf(" %d TEST(S) FAILED\n", fails);
    printf("=====================================================\n");

    return fails;   // Vitis treats non-zero as a failed C simulation
}
