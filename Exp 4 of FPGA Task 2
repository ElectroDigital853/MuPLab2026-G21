#include <iostream>
#include <iomanip>
#include "nand_perceptron.h"

int main() {
    int sw_a, sw_b;
    int led_out, led_w1_neg, led_w2_neg, led_bias_neg;
    float final_w1, final_w2, final_bias;

    std::cout << "==================================================" << std::endl;
    std::cout << "     TASK 2: NAND PERCEPTRON TRAINING SIMULATION  " << std::endl;
    std::cout << "==================================================" << std::endl;

    // Run the design function once to execute training
    nand_perceptron(0, 0, &led_out, &led_w1_neg, &led_w2_neg, &led_bias_neg, &final_w1, &final_w2, &final_bias);

    // Print calculated weights and bias
    std::cout << std::fixed << std::setprecision(2);
    std::cout << "\nCalculated Parameters after 20 Epochs:" << std::endl;
    std::cout << "  Weight 1 (w1) : " << final_w1 << " (LED Neg Flag: " << led_w1_neg << ")" << std::endl;
    std::cout << "  Weight 2 (w2) : " << final_w2 << " (LED Neg Flag: " << led_w2_neg << ")" << std::endl;
    std::cout << "  Bias          : " << final_bias << " (LED Neg Flag: " << led_bias_neg << ")" << std::endl;

    std::cout << "\n--------------------------------------------------" << std::endl;
    std::cout << " Verification of Learned NAND Gate Logic:" << std::endl;
    std::cout << " Input A | Input B | Expected | NAND Output | Status" << std::endl;
    std::cout << "--------------------------------------------------" << std::endl;

    int test_inputs[4][2] = {{0,0}, {0,1}, {1,0}, {1,1}};
    int expected_nand[4]  = {1, 1, 1, 0};
    bool all_passed = true;

    for (int i = 0; i < 4; i++) {
        sw_a = test_inputs[i][0];
        sw_b = test_inputs[i][1];

        // Evaluate trained perceptron for each input pair
        nand_perceptron(sw_a, sw_b, &led_out, &led_w1_neg, &led_w2_neg, &led_bias_neg, &final_w1, &final_w2, &final_bias);

        bool pass = (led_out == expected_nand[i]);
        if (!pass) all_passed = false;

        std::cout << "    " << sw_a << "    |    " << sw_b << "    |    " 
                  << expected_nand[i] << "     |      " << led_out << "      | " 
                  << (pass ? "PASS" : "FAIL") << std::endl;
    }

    std::cout << "--------------------------------------------------" << std::endl;
    if (all_passed) {
        std::cout << "RESULT: NAND Gate Perceptron Training PASSED!\n" << std::endl;
        return 0;
    } else {
        std::cout << "RESULT: Training FAILED!\n" << std::endl;
        return 1;
    }
}
