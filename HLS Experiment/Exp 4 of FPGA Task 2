#include "nand.h"

// Step function: output 1 if z >= 0, else 0
int step(float z)
{
    if (z >= 0) return 1;
    else        return 0;
}

// Train the perceptron on the NAND truth table
void train(float &w1, float &w2, float &bias)
{
    int x1[4] = {0, 0, 1, 1};
    int x2[4] = {0, 1, 0, 1};
    int t[4]  = {1, 1, 1, 0};     // NAND outputs

    // arbitrary starting values
    w1   =  0.3;
    w2   = -0.3;
    bias =  0.2;

    for (int e = 0; e < EPOCHS; e++) {
        for (int i = 0; i < 4; i++) {
            int y   = step(w1 * x1[i] + w2 * x2[i] + bias);
            int err = t[i] - y;

            w1   = w1   + ETA * err * x1[i];
            w2   = w2   + ETA * err * x2[i];
            bias = bias + ETA * err;
        }
    }
}

// Turns a value into "tenths" for the LEDs, e.g. -0.3 -> 3
ap_uint<4> tenths(float v)
{
    if (v < 0) v = -v;
    return (int)(v * 10 + 0.5f);
}

// Top function (this goes on the FPGA)
void nand_perceptron(ap_uint<1> a, ap_uint<1> b, ap_uint<16> &leds)
{
    float w1, w2, bias;
    train(w1, w2, bias);

    ap_uint<16> out = 0;
    out.range(3, 0)   = tenths(w1);     // LED 0-3  : |w1|   x 10
    out.range(7, 4)   = tenths(w2);     // LED 4-7  : |w2|   x 10
    out.range(11, 8)  = tenths(bias);   // LED 8-11 : |bias| x 10
    out[12] = (w1   < 0);               // LED 12   : w1 negative
    out[13] = (w2   < 0);               // LED 13   : w2 negative
    out[14] = (bias < 0);               // LED 14   : bias negative
    out[15] = step(w1 * a + w2 * b + bias);   // LED 15 : NAND(a, b)

    leds = out;
}

