#include <stdio.h>
#include "nand.h"

int main()
{
    float w1, w2, bias;
    train(w1, w2, bias);

    printf("Final weights: w1 = %.2f, w2 = %.2f\n", w1, w2);
    printf("Final bias   : b  = %.2f\n\n", bias);

    int errors = 0;
    printf(" a  b | expected | output\n");

    for (int a = 0; a <= 1; a++) {
        for (int b = 0; b <= 1; b++) {
            ap_uint<16> leds;
            nand_perceptron(a, b, leds);

            int expected = !(a && b);
            int output   = leds[15];
            if (output != expected) errors++;

            printf(" %d  %d |    %d     |   %d\n", a, b, expected, output);
        }
    }

    if (errors == 0) printf("\nNAND verified: PASS\n");
    else             printf("\nNAND verified: FAIL\n");

    return errors;
}
